# Copy to .env.local for local development, or add these in
# Vercel → Project → Settings → Environment Variables.

# Public URL of the site (used for canonical links, sitemap and social cards).
# Optional on Vercel: the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Turso (libSQL) database for enquiries and admin settings.
# Local development falls back to ./local.db when unset.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Password for /admin. Leave unset to disable the admin area.
ADMIN_PASSWORD=
# Optional extra secret mixed into the admin session signature.
ADMIN_SESSION_SECRET=
